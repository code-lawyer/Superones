proxy_http_version 1.1;
proxy_set_header Host $host;
proxy_set_header X-Forwarded-Proto https;
proxy_set_header X-Forwarded-Host $host;
proxy_set_header Connection "";

# Do not manufacture or accept an unsigned identity header here. The upstream
# identity gateway must overwrite the configured assertion header and sign it;
# the application independently verifies that JWT through the configured JWKS.
