upstream vault2077_app {
    server 127.0.0.1:3000;
    keepalive 32;
}

# This file is included from nginx's http context on standard Debian/Ubuntu
# installations, so the shared ingest limit zone is declared once here.
limit_req_zone $binary_remote_addr zone=vault2077_ingest:10m rate=10r/m;
server_tokens off;

server {
    listen 80;
    server_name superones.top www.superones.top;
    return 301 https://superones.top$request_uri;
}

server {
    listen 80;
    server_name admin.superones.top;
    return 301 https://admin.superones.top$request_uri;
}

# Public site: the administration surface is deliberately absent.
server {
    listen 443 ssl http2;
    server_name superones.top www.superones.top;

    ssl_certificate /etc/letsencrypt/live/superones.top/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/superones.top/privkey.pem;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header X-Frame-Options "DENY" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cross-Origin-Resource-Policy "same-origin" always;
    add_header X-DNS-Prefetch-Control "off" always;

    error_page 404 = @public_edge_not_found;
    error_page 405 = @public_edge_method_not_allowed;

    location @public_edge_not_found {
        include /etc/nginx/snippets/vault2077-edge-error-security.conf;
        return 404;
    }

    location @public_edge_method_not_allowed {
        include /etc/nginx/snippets/vault2077-edge-error-security.conf;
        return 405;
    }

    location = /admin { return 404; }
    location ^~ /api/admin/ { return 404; }
    location = /pipeline { return 404; }

    # The write-side cross-border endpoint. Authentication remains HMAC-based
    # in the application; this edge limit protects it before Node reads the body.
    location = /api/internal/acquisition {
        if ($request_method != POST) { return 405; }
        limit_req zone=vault2077_ingest burst=20 nodelay;
        client_max_body_size 8m;
        proxy_pass http://vault2077_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection "";
        proxy_connect_timeout 10s;
        proxy_read_timeout 75s;
        proxy_send_timeout 75s;
    }

    # Frontier reads only a sanitized public-task manifest through a separate,
    # read-only credential. It never receives worker, database, LLM, or admin
    # credentials.
    location = /api/internal/frontier/tasks {
        if ($request_method != GET) { return 405; }
        limit_req zone=vault2077_ingest burst=10 nodelay;
        proxy_pass http://vault2077_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection "";
        proxy_connect_timeout 10s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
    }

    # All other internal routes, especially the domestic processing route, are
    # unreachable from the public Internet.
    location ^~ /api/internal/ { return 404; }

    location / {
        proxy_pass http://vault2077_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection "";
    }
}

# Administration site: the application performs a same-origin WebAuthn/Passkey
# ceremony and creates a revocable server-side session after verification.
server {
    listen 443 ssl http2;
    server_name admin.superones.top;

    ssl_certificate /etc/letsencrypt/live/admin.superones.top/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/admin.superones.top/privkey.pem;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header X-Frame-Options "DENY" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cross-Origin-Resource-Policy "same-origin" always;
    add_header X-DNS-Prefetch-Control "off" always;
    add_header X-Robots-Tag "noindex, nofollow" always;

    error_page 404 = @admin_edge_not_found;

    location @admin_edge_not_found {
        include /etc/nginx/snippets/vault2077-edge-error-security.conf;
        return 404;
    }

    location = /admin {
        proxy_pass http://vault2077_app;
        include /etc/nginx/snippets/vault2077-admin-proxy.conf;
    }

    location ^~ /api/admin/ {
        proxy_pass http://vault2077_app;
        include /etc/nginx/snippets/vault2077-admin-proxy.conf;
    }

    location = /pipeline {
        proxy_pass http://vault2077_app;
        include /etc/nginx/snippets/vault2077-admin-proxy.conf;
    }

    location ^~ /_next/ {
        proxy_pass http://vault2077_app;
        include /etc/nginx/snippets/vault2077-admin-proxy.conf;
    }

    location / { return 404; }
}
