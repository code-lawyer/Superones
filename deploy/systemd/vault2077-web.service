[Unit]
Description=Vault2077 web application
After=network-online.target
Wants=network-online.target
OnFailure=vault2077-failure-notify@%n.service

[Service]
Type=simple
User=vault2077
Group=vault2077
WorkingDirectory=/srv/vault2077/current
EnvironmentFile=/etc/vault2077/production.env
Environment=NODE_ENV=production
Environment=PATH=/opt/node/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
Environment=NODE_OPTIONS=--max-old-space-size=384
Environment=PORT=3000
ExecStartPre=/opt/node/bin/npm run deploy:check
ExecStartPre=/opt/node/bin/npm run db:migrate
ExecStart=/opt/node/bin/npm run start -- --hostname 127.0.0.1
Restart=on-failure
RestartSec=5
TimeoutStartSec=180
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=/srv/vault2077/current/.next

[Install]
WantedBy=multi-user.target
