[Unit]
Description=Vault2077 web application
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=vault2077
Group=vault2077
WorkingDirectory=/srv/vault2077/current
EnvironmentFile=/etc/vault2077/production.env
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3000
ExecStartPre=/usr/bin/npm run deploy:check
ExecStartPre=/usr/bin/npm run db:migrate
ExecStart=/usr/bin/npm run start
Restart=on-failure
RestartSec=5
TimeoutStartSec=180
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/srv/vault2077/current/.next

[Install]
WantedBy=multi-user.target
