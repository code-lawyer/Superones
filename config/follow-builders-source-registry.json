{
  "version": 2,
  "upstream": {
    "repository": "zarazhangrui/follow-builders",
    "sourcePath": "config/default-sources.json"
  },
  "trustPolicy": "Follow Builders owns upstream source selection. Vault2077 consumes each published feed in full and adds no local source admission, deduplication, or content-review layer.",
  "failureMode": "isolated",
  "feeds": {
    "x": {
      "url": "https://raw.githubusercontent.com/zarazhangrui/follow-builders/main/feed-x.json",
      "lookbackHours": 24,
      "staleAfterHours": 36,
      "maxAccounts": 100,
      "maxItemsPerAccount": 20,
      "maxItemsPerFeed": 2000
    },
    "blogs": {
      "url": "https://raw.githubusercontent.com/zarazhangrui/follow-builders/main/feed-blogs.json",
      "lookbackHours": 72,
      "staleAfterHours": 96,
      "maxItemsPerFeed": 500
    },
    "podcasts": {
      "url": "https://raw.githubusercontent.com/zarazhangrui/follow-builders/main/feed-podcasts.json",
      "lookbackHours": 336,
      "staleAfterHours": 360,
      "maxItemsPerFeed": 500
    }
  }
}
