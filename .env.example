# Required for production. Run `npm run db:migrate` before starting the app.
VAULT2077_DATABASE_URL=postgresql://vault2077:change-me@127.0.0.1:5432/vault2077
VAULT2077_DATABASE_SSL=require
# 2C2G baseline. Raise only after observing sustained pool wait time.
VAULT2077_DATABASE_POOL_SIZE=4

# Ranger public avatars. Production requires OSS; local development defaults to
# data/ranger-media and serves files through /media/* when this block is omitted.
VAULT2077_RANGER_MEDIA_STORAGE=oss
VAULT2077_OSS_REGION=oss-cn-shanghai
VAULT2077_OSS_BUCKET=vault2077-public-media
VAULT2077_OSS_ACCESS_KEY_ID=replace-with-minimum-scope-ram-key
VAULT2077_OSS_ACCESS_KEY_SECRET=replace-with-minimum-scope-ram-secret
VAULT2077_OSS_PUBLIC_ORIGIN=https://media.superones.top
# true only when the VPS and Bucket use a working same-region internal endpoint.
VAULT2077_OSS_INTERNAL=true
# Optional local-only override.
VAULT2077_RANGER_MEDIA_DIR=

# Required for production. Local development uses safe development-only fallbacks.
# JSON keyrings support overlap during rotation. The active ID must exist in
# the corresponding object. Keep at most the current and previous keys.
VAULT2077_DATA_KEYS='{"2026-07":"replace-with-a-long-random-secret"}'
VAULT2077_DATA_ACTIVE_KEY_ID=2026-07
VAULT2077_OPC_RESUME_TOKEN_KEYS='{"2026-08":"replace-with-a-different-long-random-secret"}'
VAULT2077_OPC_RESUME_TOKEN_ACTIVE_KEY_ID=2026-08
VAULT2077_ADMIN_SESSION_SECRET=replace-with-another-long-random-secret
VAULT2077_AUDIT_HASH_SECRET=replace-with-a-separate-long-random-secret
# Confirmed public website and mainland China ICP filing.
VAULT2077_PUBLIC_ORIGIN=https://superones.top
VAULT2077_ICP_NUMBER=沪ICP备2026003401号-1
# Public business-license disclosure. Copy these fields exactly from the license.
VAULT2077_OPERATOR_CREDIT_CODE=91310000MAC3G0M33G
VAULT2077_OPERATOR_REGISTERED_ADDRESS=中国（上海）自由贸易试验区临港新片区环湖西二路888号C楼
VAULT2077_OPERATOR_LEGAL_REPRESENTATIVE=胡丛蕊
VAULT2077_OPERATOR_REGISTERED_CAPITAL=50万元人民币
VAULT2077_LEGAL_CONTACT_EMAIL=lanzhouda@tsinglaw.com
# Optional; falls back to the legal contact email when omitted.
VAULT2077_CUSTOMER_SERVICE_EMAIL=
VAULT2077_LEGAL_EFFECTIVE_DATE=2026-08-01
VAULT2077_OPC_PAPER_CHECKOUT_ENABLED=false
VAULT2077_OPC_OFFLINE_PAYMENT_ENABLED=false
VAULT2077_OPC_PAYMENT_EMAIL_ENABLED=false
VAULT2077_SMTP_HOST=smtp.163.com
VAULT2077_SMTP_PORT=465
VAULT2077_SMTP_USER=
VAULT2077_SMTP_PASSWORD=
VAULT2077_SMTP_FROM=
VAULT2077_OPC_ESIGN_ENABLED=false
VAULT2077_OPC_ESIGN_PROVIDER=esign
VAULT2077_ESIGN_APP_ID=
VAULT2077_ESIGN_APP_SECRET=
VAULT2077_ESIGN_API_BASE_URL=https://openapi.esign.cn
VAULT2077_ESIGN_INDIVIDUAL_TEMPLATE_ID=
VAULT2077_ESIGN_ORGANIZATION_TEMPLATE_ID=
VAULT2077_ESIGN_TEMPLATE_VERSION=
VAULT2077_ESIGN_PROVIDER_SEAL_ID=
VAULT2077_ESIGN_INDIVIDUAL_PROVIDER_SIGN_POSITION={"positionPage":"1","positionX":0,"positionY":0}
VAULT2077_ESIGN_ORGANIZATION_PROVIDER_SIGN_POSITION={"positionPage":"1","positionX":0,"positionY":0}
VAULT2077_OPC_CONTRACT_ARCHIVE_STORAGE=local
VAULT2077_OPC_CONTRACT_ARCHIVE_DIR=
# Production: use a dedicated private bucket, never VAULT2077_OSS_BUCKET.
VAULT2077_OPC_CONTRACT_OSS_REGION=oss-cn-shanghai
VAULT2077_OPC_CONTRACT_OSS_BUCKET=vault2077-private-opc-contracts
VAULT2077_OPC_CONTRACT_OSS_ACCESS_KEY_ID=
VAULT2077_OPC_CONTRACT_OSS_ACCESS_KEY_SECRET=
VAULT2077_OPC_CONTRACT_OSS_INTERNAL=true
VAULT2077_OPC_CONTRACT_RETENTION_YEARS=10
VAULT2077_OPC_CONTRACT_RETENTION_LOCKED=false
# Separate HTTPS admin origin. Native WebAuthn derives its RP ID from this host.
VAULT2077_ADMIN_ORIGIN=https://admin.superones.top
# Production owner is fixed in code. Bootstrap with `npm run admin:passkey:enroll`
# over SSH; the one-time token expires after ten minutes and is never stored raw.
# Local development only. Production rejects both password variables.
# Generate the hash with VAULT2077_ADMIN_PASSWORD_INPUT + `npm run admin:hash-password`.
VAULT2077_ADMIN_PASSWORD_HASH=
# Production requires the supplied Nginx template, which overwrites client
# forwarding headers before the application trusts them.
VAULT2077_TRUST_PROXY_HEADERS=true

# Domestic server read-only credential for Frontier verification and participant
# observations. Required for production Frontier. GitHub Actions uses its
# ephemeral read-only `github.token` instead of copying this credential overseas.
GITHUB_TOKEN=
VAULT2077_GITHUB_TIMEOUT_MS=4000
VAULT2077_GITHUB_CONCURRENCY=4

# Hourly Frontier ranking refresh and automatic quarterly settlement.
VAULT2077_FRONTIER_WRITES_ENABLED=false
# Per-season reward drafts and publication are managed in the protected admin.
VAULT2077_FRONTIER_TICK_SECRET=replace-with-a-long-random-secret
# Authenticated production readiness/freshness endpoint.
VAULT2077_HEALTH_SECRET=replace-with-a-long-random-secret

# Content pipeline: the overseas collector signs public-only source packets;
# this domestic endpoint verifies them before any LLM processing or publishing.
VAULT2077_PIPELINE_SIGNING_KEYS='{"2026-07":"replace-with-a-long-random-secret"}'
VAULT2077_PIPELINE_ACTIVE_KEY_ID=2026-07
# Protects the loopback-only manual processing route.
VAULT2077_PIPELINE_WORKER_SECRET=replace-with-a-separate-long-random-secret
# Read-only cross-border credential for public Frontier fallback tasks.
VAULT2077_FRONTIER_TASKS_SECRET=replace-with-another-long-random-secret
# Local development/preview only. Production writes PostgreSQL.
VAULT2077_DATA_DIR=./data
VAULT2077_ALLOW_FILE_PREVIEW=false
# Optional emergency override. Normally read from config/source-bundle.json.
VAULT2077_SOURCE_BUNDLE_REVISION=
# Legacy AcquisitionBatch v1 only: optional comma-separated overlap during a controlled rollout.
# AcquisitionBatch v2 carries a signed source snapshot and does not require exact revision parity.
VAULT2077_ALLOWED_SOURCE_REVISIONS=
VAULT2077_SOURCE_BUNDLE_FILE=config/source-bundle.json
VAULT2077_ACQUISITION_MAX_RECORDS=200
# One-time audited launch backfill; scheduled jobs always use incremental.
VAULT2077_ACQUISITION_RUN_MODE=incremental
# Domestic inbox retries transient processing failures before quarantine.
VAULT2077_ACQUISITION_MAX_ATTEMPTS=6
VAULT2077_ACQUISITION_WORKER_MAX_BATCHES=8
VAULT2077_COLLECTOR_CONCURRENCY=24
VAULT2077_HORIZON_CONCURRENCY=24
VAULT2077_PER_HOST_CONCURRENCY=4
VAULT2077_SOURCE_TIMEOUT_SECONDS=20
VAULT2077_MAX_UPSTREAM_BYTES=8000000
# Unified collector-side domestic endpoints (configured as GitHub Actions secrets).
VAULT2077_DOMESTIC_ACQUISITION_URL=
VAULT2077_DELIVERY_ATTEMPTS=4
VAULT2077_DELIVERY_TIMEOUT_MS=60000
VAULT2077_DELIVERY_RETRY_BASE_MS=1000
# Domestic public-only Frontier fallback task feed, read by the rankings lane.
VAULT2077_FRONTIER_PUBLIC_TASKS_URL=
# Set in GitHub Actions so a missing VPS endpoint can never produce a false-green run.
VAULT2077_REQUIRE_DOMESTIC_DELIVERY=false
# Vault editorial profile: information, roadside, and event composition.
VAULT2077_VAULT_LLM_BASE_URL=https://api.deepseek.com/v1
VAULT2077_VAULT_LLM_API_KEY=
VAULT2077_VAULT_LLM_MODEL=deepseek-v4-flash
VAULT2077_VAULT_LLM_TIMEOUT_MS=30000
VAULT2077_VAULT_LLM_CONCURRENCY=2
VAULT2077_VAULT_LLM_BATCH_ITEMS=3
VAULT2077_VAULT_LLM_MAX_REQUESTS_PER_RUN=300
VAULT2077_VAULT_LLM_MAX_TOKENS=
VAULT2077_VAULT_LLM_REASONING_EFFORT=
# Optional controlled fallback for Vault; used only after an eligible failure.
VAULT2077_VAULT_LLM_FALLBACK_BASE_URL=
VAULT2077_VAULT_LLM_FALLBACK_API_KEY=
VAULT2077_VAULT_LLM_FALLBACK_MODEL=
VAULT2077_VAULT_LLM_FALLBACK_TIMEOUT_MS=30000

# SiC editorial profile: technical long-form and research material.
VAULT2077_SIC_LLM_BASE_URL=https://api.xiaomimimo.com/v1
VAULT2077_SIC_LLM_API_KEY=
VAULT2077_SIC_LLM_MODEL=mimo-v2.5
VAULT2077_SIC_LLM_TIMEOUT_MS=60000
VAULT2077_SIC_LLM_CONCURRENCY=1
VAULT2077_SIC_LLM_BATCH_ITEMS=2
VAULT2077_SIC_LLM_MAX_REQUESTS_PER_RUN=200
VAULT2077_SIC_LLM_MAX_TOKENS=
VAULT2077_SIC_LLM_REASONING_EFFORT=
# Optional controlled fallback for SiC.
VAULT2077_SIC_LLM_FALLBACK_BASE_URL=
VAULT2077_SIC_LLM_FALLBACK_API_KEY=
VAULT2077_SIC_LLM_FALLBACK_MODEL=
VAULT2077_SIC_LLM_FALLBACK_TIMEOUT_MS=60000
# Production always audits model routing; enable explicitly for local audit rehearsal.
VAULT2077_ENABLE_PROCESSING_AUDIT=false

# Legacy shared profile is accepted only outside production during migration.
VAULT2077_LLM_BASE_URL=
VAULT2077_LLM_API_KEY=
VAULT2077_LLM_MODEL=
