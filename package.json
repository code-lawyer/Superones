{
  "name": "vault2077",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.7.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "docs:check": "node scripts/check-docs.mjs",
    "test": "node --test --conditions=react-server --experimental-strip-types tests/*.test.ts",
    "test:pipeline:e2e": "npm run build && node scripts/run-content-pipeline-e2e.mjs",
    "test:acquisition:e2e": "npm run build && node scripts/run-acquisition-inbox-e2e.mjs",
    "content:validate-packets": "node --experimental-strip-types scripts/validate-content-packets.ts",
    "db:migrate": "node scripts/migrate-database.mjs",
    "test:postgres:integration": "node --conditions=react-server --experimental-strip-types scripts/test-postgres-integration.ts",
    "admin:hash-password": "node scripts/hash-admin-password.mjs",
    "admin:passkey:enroll": "node --conditions=react-server --experimental-strip-types scripts/create-admin-passkey-enrollment.ts",
    "opc:sync-seed": "node --conditions=react-server --experimental-strip-types scripts/sync-opc-seed.ts",
    "opc:build-default-seed": "node --experimental-strip-types scripts/build-opc-default-seed.ts",
    "opc:cleanup-ranger-media": "node --conditions=react-server --experimental-strip-types scripts/cleanup-ranger-media.ts",
