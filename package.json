{
  "name": "vault2077",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.7.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "docs:check": "node scripts/check-docs.mjs",
    "test": "node --test --conditions=react-server --experimental-strip-types tests/*.test.ts",
    "test:pipeline:e2e": "npm run build && node scripts/run-content-pipeline-e2e.mjs",
    "test:acquisition:e2e": "npm run build && node scripts/run-acquisition-inbox-e2e.mjs",
    "content:validate-packets": "node --experimental-strip-types scripts/validate-content-packets.ts",
    "db:migrate": "node scripts/migrate-database.mjs",
    "test:postgres:integration": "node --conditions=react-server --experimental-strip-types scripts/test-postgres-integration.ts",
    "admin:hash-password": "node scripts/hash-admin-password.mjs",
    "deploy:check": "node --conditions=react-server --experimental-strip-types scripts/check-production-config.ts",
    "frontier:tick": "node --conditions=react-server --experimental-strip-types scripts/run-frontier-tick.ts",
    "dev:check": "node scripts/check-dev-server.mjs",
    "sources:extract": "node scripts/build-source-registry.mjs",
    "sources:classify": "node scripts/classify-source-registry.mjs",
    "sources:audit": "node scripts/audit-source-registry.mjs",
    "sources:bundle": "node scripts/build-source-bundle.mjs",
    "acquisition:collect": "node --conditions=react-server --experimental-strip-types scripts/collect-unified-acquisition.ts",
    "pipeline:local": "node scripts/run-local-full-pipeline.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "jose": "^6.2.4",
    "next": "16.2.11",
    "pg": "^8.22.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/pg": "^8.20.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
