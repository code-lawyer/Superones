    "opc:send-payment-emails": "node --env-file-if-exists=.env.local --conditions=react-server --experimental-strip-types scripts/process-opc-payment-notifications.ts",
    "opc:maintain-orders": "node --env-file-if-exists=.env.local --conditions=react-server --experimental-strip-types scripts/run-opc-order-maintenance.ts",
