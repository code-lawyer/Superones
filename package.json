    "deploy:verify-editorial": "node --conditions=react-server --experimental-strip-types scripts/verify-editorial-providers.ts",
    "health:check": "node --experimental-strip-types scripts/check-operations-health.ts",
    "frontier:tick": "node --conditions=react-server --experimental-strip-types scripts/run-frontier-tick.ts",
    "dev:check": "node scripts/check-dev-server.mjs",
    "sources:extract": "node scripts/build-source-registry.mjs",
    "sources:classify": "node scripts/classify-source-registry.mjs",
    "sources:audit": "node scripts/audit-source-registry.mjs",
    "sources:bundle": "node scripts/build-source-bundle.mjs",
    "acquisition:collect": "node --conditions=react-server --experimental-strip-types scripts/collect-unified-acquisition.ts",
    "acquisition:validate-artifact": "node --experimental-strip-types scripts/validate-acquisition-artifact.ts",
    "acquisition:work": "node --conditions=react-server --experimental-strip-types scripts/run-acquisition-worker.ts",
    "pipeline:local": "node scripts/run-local-full-pipeline.mjs",
    "bootstrap:diagnose-events": "node --conditions=react-server --experimental-strip-types scripts/diagnose-event-candidates.ts",
    "bootstrap:materialize": "node --conditions=react-server --experimental-strip-types scripts/materialize-bootstrap-content.ts",
    "bootstrap:materialize-sic": "node --env-file-if-exists=.env.local --conditions=react-server --experimental-strip-types scripts/materialize-bootstrap-sic.ts",
    "bootstrap:seed-events": "node --conditions=react-server --experimental-strip-types scripts/seed-bootstrap-events.ts",
    "bootstrap:reconcile-events": "node --conditions=react-server --experimental-strip-types scripts/reconcile-bootstrap-events.ts",
    "bootstrap:promote": "node --conditions=react-server --experimental-strip-types scripts/promote-bootstrap-run.ts",
    "bootstrap:refresh-manifest": "node --experimental-strip-types scripts/refresh-bootstrap-manifest.ts",
    "bootstrap:verify": "node --experimental-strip-types scripts/verify-bootstrap-content.ts",
